---
import "@fontsource-variable/schibsted-grotesk/wght.css";
import "#src/styles/global.css";
import Analytics from "@vercel/analytics/astro";
import { site } from "#src/config/site.ts";

interface Props {
  noindex?: boolean;
  title?: string;
}

const { title = `${site.name} — ${site.role}`, noindex = false } = Astro.props;
const preventIndexing = noindex || import.meta.env.VERCEL_ENV === "preview";
const canonical = new URL(Astro.url.pathname, site.url);
const socialImage = new URL(site.socialImage.path, site.url);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  description: site.description,
  jobTitle: "Software Engineer",
  name: site.name,
  sameAs: site.social.map(({ href }) => href),
  url: site.url,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta content="width=device-width, initial-scale=1" name="viewport">
    <meta content={site.description} name="description">
    <meta content={site.name} name="author">
    <meta content="#ffffff" name="theme-color">
    <meta content="light" name="color-scheme">
    {preventIndexing && <meta content="noindex, nofollow" name="robots" />}
    <link href={canonical} rel="canonical">
    <link href="/favicon.svg" rel="icon" type="image/svg+xml">
    <link href="/favicon-32.png" rel="icon" sizes="32x32" type="image/png">
    <link href="/apple-touch-icon.png" rel="apple-touch-icon" sizes="180x180">
    <link href="/sitemap-index.xml" rel="sitemap">
    <meta content="website" property="og:type">
    <meta content="en_GB" property="og:locale">
    <meta content={site.name} property="og:site_name">
    <meta content={title} property="og:title">
    <meta content={site.description} property="og:description">
    <meta content={canonical} property="og:url">
    <meta content={socialImage} property="og:image">
    <meta content="image/png" property="og:image:type">
    <meta content={String(site.socialImage.width)} property="og:image:width">
    <meta content={String(site.socialImage.height)} property="og:image:height">
    <meta content={site.socialImage.alt} property="og:image:alt">
    <meta content="summary_large_image" name="twitter:card">
    <meta content={socialImage} name="twitter:image">
    <meta content={site.socialImage.alt} name="twitter:image:alt">
    <meta content={title} name="twitter:title">
    <meta content={site.description} name="twitter:description">
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData).replaceAll("<", "\\u003c")}
    />
    <title>{title}</title>
  </head>
  <body>
    <a
      class="fixed top-4 left-4 z-10 -translate-y-24 bg-paper p-3 focus:translate-y-0"
      href="#main"
      >Skip to content</a
    >
    <div class="max-w-176 px-6 pt-12 pb-12 sm:px-12 sm:pt-20 lg:px-20 lg:pt-24">
      <main id="main">
        <slot />
      </main>
      <slot name="footer" />
    </div>
    {import.meta.env.VERCEL_ENV === "production" && <Analytics />}
  </body>
</html>
